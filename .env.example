# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env

# Supabase — Settings > API no painel do projeto
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# Chave compartilhada entre o servidor e o NodeMCU
# Gere uma nova: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_KEY=sua_device_key_aqui

# Porta do servidor (Railway define automaticamente; para local use 3000)
PORT=3000
